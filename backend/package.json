{
  "name": "family-network-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "node --test ../tools/graph-core.test.mjs test/app-module.test.cjs test/family-builder.test.cjs",
    "test:integration": "node --test test/api.integration.test.cjs",
    "benchmark:graph": "node ../tools/graph-benchmark.mjs",
