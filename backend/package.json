    "build:strict": "tsc --noEmit",
    "release:smoke": "node ../scripts/release-smoke.mjs",
    "release:check": "node ../scripts/check-release.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.8",
    "@nestjs/core": "^10.4.8",
    "@nestjs/platform-express": "^10.4.8",
