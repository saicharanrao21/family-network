NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/family_network?schema=public
JWT_ACCESS_SECRET=GENERATE_A_LONG_RANDOM_SECRET_64_PLUS_CHARS
ADMIN_USER_IDS=comma,separated,verified,user,ids
CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Provider credentials: inject through the deployment secret manager; never commit them.
RESEND_API_KEY=
EMAIL_FROM=Family Network <no-reply@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
FCM_SERVER_KEY=

# Billing webhook signing secrets
RAZORPAY_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
